<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Verify Registration OTP — Pujyasritha's Living">
  <title>Verify Registration OTP — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <%- include('../partials/header', { user: null }) %>

  <div class="auth-wrapper">
    <div class="auth-card anim-fade-scale" style="max-width: 440px;">
      <div class="auth-header">
        <div class="auth-header-icon" style="background:linear-gradient(135deg,#fdfaf4,#f2d9b3);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#b8762e" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1>Email Verification</h1>
        <p>Enter the 6-digit registration code sent to<br><strong style="color:var(--text-primary);"><%= email %></strong></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } else { %>
        <div class="alert alert-info" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Code sent successfully. Please check your inbox or spam.
        </div>
      <% } %>

      <form action="/auth/verify-otp" method="POST">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="purpose" value="<%= purpose %>">
        
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label for="code" style="text-align: center; margin-bottom: 0.6rem;">6-Digit OTP Security Code</label>
          <input
            type="text"
            id="code"
            name="code"
            class="form-control otp-input"
            placeholder="······"
            maxlength="6"
            pattern="\d{6}"
            required
            autofocus
            autocomplete="one-time-code"
          >
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:0.25rem;">
          Verify Email & Complete Registration
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </form>

      <div style="margin-top: 1.25rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); padding-top: 1rem; border-top: 1px solid var(--border-light);">
        <div>
          Code expires in: <strong id="timerCountdown" style="color: var(--primary); font-family: monospace; font-size: 0.95rem;">05:00</strong>
        </div>
        <form action="<%= purpose === 'admin-register' ? '/admin/register' : '/register' %>" method="POST" style="margin: 0;">
          <input type="hidden" name="email" value="<%= email %>">
          <input type="hidden" name="purpose" value="<%= purpose %>">
          <button type="submit" class="btn btn-outline btn-sm" style="width: auto;">Resend Code</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var duration = 300; // 5 minutes in seconds
      var display = document.getElementById('timerCountdown');
      var timer = duration, minutes, seconds;
      
      var interval = setInterval(function () {
        minutes = parseInt(timer / 60, 10);
        seconds = parseInt(timer % 60, 10);

        minutes = minutes < 10 ? "0" + minutes : minutes;
        seconds = seconds < 10 ? "0" + seconds : seconds;

        if (display) {
          display.textContent = minutes + ":" + seconds;
        }

        if (--timer < 0) {
          clearInterval(interval);
          if (display) {
            display.textContent = "Expired";
            display.style.color = "#b91c1c";
          }
        }
      }, 1000);
    })();
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
