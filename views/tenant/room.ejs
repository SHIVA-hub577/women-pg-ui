<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="My Suite & Roommates — Pujyasritha's Living">
  <title>My Room & Suite — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-tenant">
  <%- include('../partials/header') %>

  <div class="app-container" style="max-width: 960px;">
    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>My Suite & Community</h1>
          <p>Welcome back, <strong style="color:var(--primary);"><%= user ? (user.name || user.username) : 'Resident' %></strong></p>
        </div>
      </div>

      <% if (room && tenant) { %>
        <div class="metric-grid">
          <div class="metric-card">
            <div class="metric-icon metric-icon-brand">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div>
              <div class="metric-title">Suite Allotted</div>
              <div class="metric-value">Room <%= room.roomNumber %></div>
              <div class="metric-sub"><%= room.sharingType %> Sharing Configuration</div>
            </div>
          </div>

          <div class="metric-card">
            <div class="metric-icon metric-icon-sage">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <div class="metric-title">Monthly Rent</div>
              <div class="metric-value" style="color: #2d6b4a;">&#8377;<%= (tenant.rent || room.rent || 0).toLocaleString('en-IN') %></div>
              <div class="metric-sub">Due monthly</div>
            </div>
          </div>

          <div class="metric-card">
            <div class="metric-icon metric-icon-amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            </div>
            <div>
              <div class="metric-title">Security Advance</div>
              <div class="metric-value" style="color: var(--primary);">&#8377;<%= (tenant.advancePaid || room.advance || 0).toLocaleString('en-IN') %></div>
              <div class="metric-sub">Refundable advance</div>
            </div>
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <h3>Occupancy Details</h3>
            <span class="badge badge-green"><%= tenant.status || 'Active Resident' %></span>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Resident ID</p>
                <p style="font-weight: 700; font-size: 1.05rem; margin: 0;"><%= tenant.tenantId || 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Phone Number</p>
                <p style="font-weight: 600; font-size: 1.05rem; margin: 0;"><%= tenant.phone || 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Move-in Date</p>
                <p style="font-weight: 600; font-size: 1.05rem; margin: 0;"><%= tenant.joiningDate ? new Date(tenant.joiningDate).toLocaleDateString('en-IN') : 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Floor Location</p>
                <p style="font-weight: 600; font-size: 1.05rem; margin: 0;"><%= room.floor ? ('Floor ' + room.floor) : 'Level 2' %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3>Suite Roommates</h3>
            <span class="badge badge-brand">Community</span>
          </div>
          <div class="card-body">
            <% if (room.tenants && room.tenants.length > 1) { %>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Resident Name</th>
                      <th>Room Slot</th>
                      <th>Community Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% room.tenants.forEach((t, idx) => { %>
                      <% if (t.email !== user.email && t.tenantId !== user.tenantId) { %>
                        <tr>
                          <td>
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                              <div style="width: 34px; height: 34px; border-radius: 50%; background: var(--primary-faint); color: var(--primary-mid); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                                <%= (t.name || 'R').charAt(0).toUpperCase() %>
                              </div>
                              <strong><%= t.name %></strong>
                            </div>
                          </td>
                          <td>Bed <%= idx + 1 %></td>
                          <td><span class="badge badge-green">Active Resident</span></td>
                        </tr>
                      <% } %>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
                <p style="margin: 0; font-size: 0.95rem;">You currently have no roommates in this room.</p>
              </div>
            <% } %>
          </div>
        </div>

      <% } else { %>
        <div class="card" style="text-align: center; padding: 3.5rem 1.5rem;">
          <div style="width: 64px; height: 64px; background: var(--primary-faint); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; color: var(--primary-mid);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h2 style="margin: 0 0 0.5rem;">No Room Assigned Yet</h2>
          <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 1.5rem; font-size: 0.95rem;">
            Your resident account (<strong style="color: var(--primary);"><%= user ? user.email : '' %></strong>) has been registered successfully, but you have not been assigned to a PG suite yet. Please speak to the front desk.
          </p>
          <span class="badge badge-brand" style="font-size: 0.85rem; padding: 0.4rem 1rem;">Status: Account Registered (Unassigned)</span>
        </div>
      <% } %>

    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
