<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Resident Profile & Rent Portal — Pujyasritha's Living">
  <title>Resident Profile & Rent Portal — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-tenant">
  <%- include('../partials/header') %>

  <div class="app-container" style="max-width: 960px;">
    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>Resident Profile & Rent Portal</h1>
          <p>View your suite allotment, deposit details, and manage monthly rent seamlessly</p>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
          <%= success %>
        </div>
      <% } %>

      <% if (room && tenant) { %>
        <% 
          const rentAmount = tenant.rent || room.rent || 0;
          const isPaid = currentPayment && currentPayment.status === 'Paid';
          const isPartial = currentPayment && currentPayment.status === 'Partial';
          const partialPaid = currentPayment ? currentPayment.amountPaid : 0;
          const remainingDue = Math.max(0, rentAmount - partialPaid);
          const formattedMonth = typeof currentMonth !== 'undefined' ? currentMonth : new Date().toISOString().slice(0,7);
        %>

        <!-- Current Month Rent Payment Banner -->
        <div class="rent-banner <%= isPaid ? 'rent-banner-paid' : (isPartial ? 'rent-banner-partial' : 'rent-banner-pending') %>">
          <div style="display: flex; align-items: flex-start; gap: 1rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: <%= isPaid ? '#e0f5eb' : (isPartial ? '#fef3c7' : '#fee2e2') %>; color: <%= isPaid ? '#1f4d36' : (isPartial ? '#78350f' : '#901515') %>;">
              <% if (isPaid) { %>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <% } else if (isPartial) { %>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <% } else { %>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <% } %>
            </div>
            <div>
              <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.2rem;">
                Rent Status &bull; <%= formattedMonth %>
              </div>
              <% if (isPaid) { %>
                <h3 style="color: #1f4d36; margin: 0; font-size: 1.3rem;">
                  Rent Paid &mdash; &#8377;<%= rentAmount.toLocaleString('en-IN') %>
                </h3>
                <p style="font-size: 0.82rem; color: #2d6b4a; margin: 0.2rem 0 0;">
                  Confirmed on <%= currentPayment.paymentDate ? new Date(currentPayment.paymentDate).toLocaleDateString('en-IN') : 'Recorded' %>
                </p>
              <% } else if (isPartial) { %>
                <h3 style="color: #78350f; margin: 0; font-size: 1.3rem;">
                  Partially Paid (&#8377;<%= partialPaid.toLocaleString('en-IN') %> settled)
                </h3>
                <p style="font-size: 0.85rem; color: #854D0E; margin: 0.2rem 0 0;">
                  Remaining Balance: <strong>&#8377;<%= remainingDue.toLocaleString('en-IN') %></strong> out of &#8377;<%= rentAmount.toLocaleString('en-IN') %>
                </p>
              <% } else { %>
                <h3 style="color: #901515; margin: 0; font-size: 1.3rem;">
                  Payment Pending &mdash; &#8377;<%= rentAmount.toLocaleString('en-IN') %>
                </h3>
                <p style="font-size: 0.85rem; color: #991b1b; margin: 0.2rem 0 0;">
                  Due for the month of <%= formattedMonth %>
                </p>
              <% } %>
            </div>
          </div>

          <div>
            <% if (isPaid) { %>
              <span class="badge badge-green" style="font-size: 0.85rem; padding: 0.45rem 1rem;">
                &#10004; Settled for <%= formattedMonth %>
              </span>
            <% } else if (isPartial) { %>
              <form action="/tenant/pay" method="POST" style="margin:0;">
                <button type="submit" class="btn btn-amber" style="width:auto; padding: 0.65rem 1.4rem;">
                  Pay Remaining Due (&#8377;<%= remainingDue.toLocaleString('en-IN') %>)
                </button>
              </form>
            <% } else { %>
              <form action="/tenant/pay" method="POST" style="margin:0;">
                <button type="submit" class="btn btn-primary" style="width:auto; padding: 0.65rem 1.5rem;">
                  Pay Rent (&#8377;<%= rentAmount.toLocaleString('en-IN') %>)
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <!-- Metric Grid -->
        <div class="metric-grid">
          <div class="metric-card">
            <div class="metric-icon metric-icon-brand">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div>
              <div class="metric-title">Assigned Suite</div>
              <div class="metric-value">Room <%= room.roomNumber %></div>
              <div class="metric-sub"><%= room.sharingType %> Sharing Layout</div>
            </div>
          </div>

          <div class="metric-card">
            <div class="metric-icon metric-icon-sage">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <div class="metric-title">Monthly Rent</div>
              <div class="metric-value" style="color: #2d6b4a;">&#8377;<%= (tenant.rent || room.rent || 0).toLocaleString('en-IN') %></div>
              <div class="metric-sub">Billed monthly</div>
            </div>
          </div>

          <div class="metric-card">
            <div class="metric-icon metric-icon-amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            </div>
            <div>
              <div class="metric-title">Advance Security Deposit</div>
              <div class="metric-value" style="color: var(--primary);">&#8377;<%= (tenant.advancePaid || room.advance || 0).toLocaleString('en-IN') %></div>
              <div class="metric-sub">Refundable security</div>
            </div>
          </div>
        </div>

        <!-- Occupancy Summary Card -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <h3>Resident Occupancy Profile</h3>
            <span class="badge badge-green"><%= tenant.status || 'Active Resident' %></span>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Resident ID</p>
                <p style="font-weight: 700; font-size: 1.05rem; margin: 0;"><%= tenant.tenantId || 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Contact Phone</p>
                <p style="font-weight: 600; font-size: 1.05rem; margin: 0;"><%= tenant.phone || 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Move-in Date</p>
                <p style="font-weight: 600; font-size: 1.05rem; margin: 0;"><%= tenant.joiningDate ? new Date(tenant.joiningDate).toLocaleDateString('en-IN') : 'N/A' %></p>
              </div>
              <div>
                <p style="color: var(--text-muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.25rem;">Email ID</p>
                <p style="font-weight: 600; font-size: 1rem; margin: 0; color: var(--primary);"><%= user ? user.email : 'N/A' %></p>
              </div>
            </div>
          </div>
        </div>

      <% } else { %>
        <!-- Empty State -->
        <div class="card" style="text-align: center; padding: 3.5rem 1.5rem;">
          <div style="width: 64px; height: 64px; background: var(--primary-faint); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; color: var(--primary-mid);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h2 style="margin: 0 0 0.5rem;">No Room Assigned Yet</h2>
          <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 1.5rem; font-size: 0.95rem;">
            Your resident account (<strong style="color: var(--primary);">@<%= user ? user.username : '' %></strong>) is registered and active. Your suite allotment is currently being finalized by the management team.
          </p>
          <span class="badge badge-brand" style="font-size: 0.85rem; padding: 0.4rem 1rem;">Status: Account Registered (Unassigned)</span>
        </div>
      <% } %>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>