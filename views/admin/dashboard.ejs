<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Administrator Dashboard Overview — Pujyasritha's Living">
  <title>Admin Dashboard — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-admin">
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar', { activePage: 'dashboard' }) %>

    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>Operations Dashboard</h1>
          <p>Real-time occupancy metrics, room distribution, and residence status</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/tenants/new" class="btn btn-primary" style="width: auto;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Allot New Resident
          </a>
        </div>
      </div>

      <div class="metric-grid">
        <div class="metric-card">
          <div class="metric-icon metric-icon-brand">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div>
            <div class="metric-title">Total Suites</div>
            <div class="metric-value"><%= totalRooms %></div>
            <div class="metric-sub">Across all floors</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-sage">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <div class="metric-title">Active Residents</div>
            <div class="metric-value" style="color: #2d6b4a;"><%= totalTenants %></div>
            <div class="metric-sub">Verified residents</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-amber">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <div class="metric-title">Occupied Suites</div>
            <div class="metric-value"><%= occupiedCount %></div>
            <div class="metric-sub">Full capacity suites</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-brand">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div>
            <div class="metric-title">Vacant Suites</div>
            <div class="metric-value" style="color: #b8762e;"><%= vacantCount %></div>
            <div class="metric-sub">Available for allotment</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2>Room Capacity & Occupancy Overview</h2>
          <span class="badge badge-brand">Live Inventory</span>
        </div>
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Suite #</th>
                  <th>Sharing Configuration</th>
                  <th>Monthly Rent</th>
                  <th>Advance Security</th>
                  <th>Bed Occupancy</th>
                  <th>Current Status</th>
                </tr>
              </thead>
              <tbody>
                <% rooms.forEach(room => { %>
                  <tr>
                    <td>
                      <strong style="color: var(--primary);">Room <%= room.roomNumber %></strong>
                    </td>
                    <td><%= room.sharingType %> Sharing Layout</td>
                    <td style="font-weight: 600;">&#8377;<%= room.rent.toLocaleString('en-IN') %></td>
                    <td>&#8377;<%= room.advance.toLocaleString('en-IN') %></td>
                    <td>
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-weight: 600;"><%= room.tenants ? room.tenants.length : 0 %> / <%= room.capacity %></span>
                        <div style="flex: 1; max-width: 60px; height: 6px; background: var(--border-light); border-radius: 9999px; overflow: hidden;">
                          <div style="height: 100%; width: <%= Math.min(100, Math.round(((room.tenants ? room.tenants.length : 0) / room.capacity) * 100)) %>%; background: var(--primary-mid);"></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% if (room.status === 'Occupied') { %>
                        <span class="badge badge-green">Occupied</span>
                      <% } else if (room.status === 'Vacant') { %>
                        <span class="badge badge-amber">Vacant</span>
                      <% } else { %>
                        <span class="badge badge-brand"><%= room.status %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
