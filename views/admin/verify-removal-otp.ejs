<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Verify Resident Departure Authorization OTP — Pujyasritha's Living">
  <title>Verify Removal OTP — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-admin">
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar', { activePage: 'remove-tenant' }) %>

    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>Verify Departure Authorization Code</h1>
          <p>Confirm the 6-digit verification code emailed to the resident to release their suite assignment</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/remove-tenant" class="btn btn-outline" style="width: auto;">&larr; Cancel Departure</a>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
          <%= success %>
        </div>
      <% } %>

      <div class="card" style="max-width: 620px; margin: 0 auto;">
        <div class="card-body">
          <div class="section-card" style="background: rgba(185,28,28,0.04); border-color: rgba(185,28,28,0.2);">
            <div class="section-card-title" style="color: #b91c1c;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Pending Departure Profile
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.9rem;">
              <div>
                <span style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 700;">Resident:</span>
                <p style="margin: 0.1rem 0 0; font-weight: 600; color: var(--text-primary);"><%= residentName %></p>
              </div>
              <div>
                <span style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 700;">Suite Allotted:</span>
                <p style="margin: 0.1rem 0 0; font-weight: 600; color: var(--primary);">Room <%= roomNumber %></p>
              </div>
            </div>
            <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed rgba(185,28,28,0.2); font-size: 0.82rem; color: var(--text-secondary);">
              &#128233; An OTP authorization code was emailed to <strong style="color:var(--text-primary);"><%= residentEmail %></strong>. Please enter the code below to finalize departure.
            </div>
          </div>

          <form action="/admin/remove-tenant/verify" method="POST">
            <input type="hidden" name="tenantId" value="<%= tenantId %>">
            <input type="hidden" name="roomNumber" value="<%= roomNumber %>">

            <div class="form-group" style="text-align: center; margin: 1.5rem 0;">
              <label for="code" style="margin-bottom: 0.6rem;">6-Digit Departure Authorization Code *</label>
              <input 
                type="text" 
                id="code" 
                name="code" 
                class="form-control otp-input" 
                placeholder="······" 
                maxlength="6" 
                pattern="[0-9]{6}" 
                required 
                autofocus
                autocomplete="one-time-code"
              >
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
              <button type="submit" class="btn btn-danger" style="flex: 1;">
                Verify Code & Complete Departure
              </button>
              <a href="/admin/remove-tenant" class="btn btn-outline" style="width: auto;">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
