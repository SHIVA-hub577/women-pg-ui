<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Resident Departure & Removal Process — Pujyasritha's Living">
  <title>Resident Departure & Removal — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-admin">
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar', { activePage: 'remove-tenant' }) %>

    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>Resident Departure & Removal</h1>
          <p>Initiate departure verification with 3-step cascading selection and email OTP authorization</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/tenants" class="btn btn-outline" style="width: auto;">&larr; Residents Directory</a>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
          <%= success %>
        </div>
      <% } %>

      <div class="card" style="max-width: 800px;">
        <div class="card-body">
          <form action="#" method="POST" id="removeTenantForm">
            
            <div class="danger-zone">
              <div class="danger-zone-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Departure Authorization Protocol
              </div>
              <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1.25rem;">
                Initiating departure sends a secure 6-digit OTP to the resident's registered email address. This prevents accidental de-allocations and ensures mutual departure confirmation.
              </p>

              <!-- Cascading Fields -->
              <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                
                <!-- 1. Sharing Type Dropdown -->
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="sharingFilter">1. Select Suite Sharing Configuration <span style="color: #b91c1c;">*</span></label>
                  <select id="sharingFilter" class="form-control">
                    <option value="">-- Select Sharing Configuration --</option>
                    <option value="all">All Sharing Types</option>
                    <option value="1">1 Sharing Suite</option>
                    <option value="2">2 Sharing Suite</option>
                    <option value="3">3 Sharing Suite</option>
                    <option value="4">4 Sharing Suite</option>
                  </select>
                </div>

                <!-- 2. Room Number Dropdown (Cascading) -->
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="roomSelect">2. Select Occupied Suite <span style="color: #b91c1c;">*</span></label>
                  <select id="roomSelect" name="roomNumber" class="form-control" disabled required>
                    <option value="">-- Select Suite Number --</option>
                    <% if (occupiedRooms && occupiedRooms.length > 0) { %>
                      <% occupiedRooms.forEach(r => { %>
                        <option 
                          value="<%= r.roomNumber %>" 
                          data-sharing="<%= r.sharingType %>"
                          data-tenants='<%= JSON.stringify(r.tenants || []) %>'
                        >
                          Room <%= r.roomNumber %> &mdash; <%= r.sharingType %> Sharing (<%= r.tenants ? r.tenants.length : 0 %> occupants)
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>

                <!-- 3. Tenant Dropdown (Cascading) -->
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="tenantSelect">3. Select Resident Departing <span style="color: #b91c1c;">*</span></label>
                  <select id="tenantSelect" class="form-control" disabled required>
                    <option value="">-- Select Resident --</option>
                  </select>
                </div>

              </div>
            </div>

            <div style="margin-top: 1.5rem;">
              <button type="submit" id="submitBtn" class="btn btn-danger" disabled>
                Generate & Send Departure OTP Code
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <!-- Cascading Dropdowns & Confirmation Prompt JS -->
  <script>
    const sharingFilter = document.getElementById('sharingFilter');
    const roomSelect = document.getElementById('roomSelect');
    const tenantSelect = document.getElementById('tenantSelect');
    const submitBtn = document.getElementById('submitBtn');
    const removeForm = document.getElementById('removeTenantForm');

    sharingFilter.addEventListener('change', function() {
      const val = this.value;
      roomSelect.selectedIndex = 0;
      tenantSelect.innerHTML = '<option value="">-- Select Resident --</option>';
      tenantSelect.disabled = true;
      submitBtn.disabled = true;

      if (!val) {
        roomSelect.disabled = true;
        return;
      }

      roomSelect.disabled = false;
      const options = roomSelect.options;
      for (let i = 1; i < options.length; i++) {
        const opt = options[i];
        const sharing = opt.dataset.sharing;
        if (val === 'all' || sharing === val) {
          opt.style.display = '';
        } else {
          opt.style.display = 'none';
        }
      }
    });

    roomSelect.addEventListener('change', function() {
      tenantSelect.innerHTML = '<option value="">-- Select Resident --</option>';
      submitBtn.disabled = true;

      const selectedOpt = this.options[this.selectedIndex];
      if (!selectedOpt || !selectedOpt.value) {
        tenantSelect.disabled = true;
        return;
      }

      const tenantsData = JSON.parse(selectedOpt.dataset.tenants || '[]');
      if (tenantsData.length === 0) {
        tenantSelect.disabled = true;
        return;
      }

      tenantSelect.disabled = false;
      tenantsData.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.tenantId;
        opt.dataset.name = t.name;
        opt.dataset.email = t.email;
        opt.textContent = `${t.name} (ID: ${t.tenantId} • ${t.email || 'No email'})`;
        tenantSelect.appendChild(opt);
      });
    });

    tenantSelect.addEventListener('change', function() {
      const selectedOpt = this.options[this.selectedIndex];
      if (selectedOpt && selectedOpt.value) {
        submitBtn.disabled = false;
        removeForm.action = `/admin/tenants/${selectedOpt.value}/request-removal`;
      } else {
        submitBtn.disabled = true;
      }
    });

    removeForm.addEventListener('submit', function(e) {
      const selectedOpt = tenantSelect.options[tenantSelect.selectedIndex];
      const email = selectedOpt.dataset.email || 'the resident';
      const name = selectedOpt.dataset.name || 'Resident';

      const confirmed = confirm(`This will send a removal OTP to ${email} for ${name}. Continue?`);
      if (!confirmed) {
        e.preventDefault();
      }
    });
  </script>
</body>
</html>
