<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Rent Payments & Billing Ledger — Pujyasritha's Living">
  <title>Rent Payments Overview — Pujyasritha's Living</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-admin">
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar', { activePage: 'payments' }) %>

    <main class="main-content">
      <div class="page-header">
        <div>
          <h1>Rent Payments & Collections</h1>
          <p>Monthly billing ledger, real-time collection metrics, and payment records</p>
        </div>
        
        <div class="page-header-actions">
          <!-- Month Picker Dropdown -->
          <form action="/admin/payments" method="GET" style="display: flex; align-items: center; gap: 0.5rem; margin: 0;">
            <label for="month" style="font-size: 0.82rem; font-weight: 600; white-space: nowrap; margin-bottom: 0;">Period:</label>
            <select id="month" name="month" class="form-control" onchange="this.form.submit()" style="width: auto; padding: 0.45rem 0.85rem; font-size: 0.85rem;">
              <% if (validMonths && validMonths.length > 0) { %>
                <% validMonths.forEach(m => { %>
                  <option value="<%= m %>" <%= m === selectedMonth ? 'selected' : '' %>>
                    <%= new Date(m + '-01T00:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %> (<%= m %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </form>

          <!-- CSV Download Button -->
          <a href="/admin/payments/export?month=<%= selectedMonth %>" class="btn btn-outline btn-sm" style="width: auto;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export CSV
          </a>

          <!-- Send to Admin Email Button -->
          <a href="/admin/payments/email?month=<%= selectedMonth %>" class="btn btn-primary btn-sm" style="width: auto;" onclick="return confirm('Send payments CSV report for <%= selectedMonth %> to your admin email?')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email Report
          </a>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="9 11 12 14 22 4"/></svg>
          <%= success %>
        </div>
      <% } %>

      <!-- Financial Metric Cards -->
      <div class="metric-grid">
        <div class="metric-card">
          <div class="metric-icon metric-icon-brand">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <div class="metric-title">Total Expected</div>
            <div class="metric-value">&#8377;<%= summary ? summary.totalExpected.toLocaleString('en-IN') : '0' %></div>
            <div class="metric-sub">Period: <%= selectedMonth %></div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-sage">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div>
            <div class="metric-title">Collected Amount</div>
            <div class="metric-value" style="color: #2d6b4a;">&#8377;<%= summary ? summary.totalCollected.toLocaleString('en-IN') : '0' %></div>
            <div class="metric-sub"><%= summary ? summary.paidCount : 0 %> fully settled</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon metric-icon-alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div>
            <div class="metric-title">Outstanding Balance</div>
            <div class="metric-value" style="color: #b91c1c;">&#8377;<%= summary ? summary.totalPending.toLocaleString('en-IN') : '0' %></div>
            <div class="metric-sub"><%= summary ? summary.pendingCount : 0 %> pending / partial</div>
          </div>
        </div>
      </div>

      <!-- Payments Table -->
      <div class="card">
        <div class="card-header">
          <h2>Resident Payment Records (<%= records ? records.length : 0 %>)</h2>
          <span class="badge badge-brand"><%= selectedMonth %> Billing Cycle</span>
        </div>
        <div class="card-body" style="padding: 0;">
          <% if (records && records.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Resident Name</th>
                    <th>Suite #</th>
                    <th>Monthly Rent</th>
                    <th>Amount Paid</th>
                    <th>Payment Status</th>
                    <th>Last Date / Updated</th>
                    <th style="text-align: right;">Update Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% records.forEach(r => { %>
                    <tr>
                      <td>
                        <strong><%= r.tenantName %></strong>
                        <div style="font-size: 0.78rem; color: var(--text-muted); font-family: monospace;">ID: <%= r.tenantId %></div>
                      </td>
                      <td>
                        <span class="badge badge-brand">Room <%= r.roomNumber %></span>
                      </td>
                      <td style="font-weight: 600;">&#8377;<%= r.rent.toLocaleString('en-IN') %></td>
                      <td style="font-weight: 700; color: <%= r.status === 'Paid' ? '#2d6b4a' : (r.status === 'Partial' ? '#b8762e' : '#b91c1c') %>;">
                        &#8377;<%= r.amountPaid.toLocaleString('en-IN') %>
                      </td>
                      <td>
                        <% if (r.status === 'Paid') { %>
                          <span class="status-pill status-paid">Paid</span>
                        <% } else if (r.status === 'Partial') { %>
                          <span class="status-pill status-partial">Partial</span>
                        <% } else { %>
                          <span class="status-pill status-pending">Pending</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (r.paymentDate) { %>
                          <div style="font-weight: 500;"><%= new Date(r.paymentDate).toLocaleDateString('en-IN') %></div>
                        <% } else { %>
                          <span style="color: var(--text-faint);">Not Paid</span>
                        <% } %>
                        <% if (r.updatedBy) { %>
                          <div style="font-size: 0.72rem; color: var(--text-muted);">By: <%= r.updatedBy %></div>
                        <% } %>
                      </td>
                      <td style="text-align: right;">
                        <form action="/admin/payments/<%= r.tenantId %>/update" method="POST" style="display: inline-flex; gap: 0.4rem; align-items: center; justify-content: flex-end; margin: 0;" onsubmit="return handleStatusSubmit(this, <%= r.rent %>);">
                          <input type="hidden" name="month" value="<%= selectedMonth %>">
                          <input type="hidden" name="amountPaid" value="<%= r.amountPaid %>">

                          <select name="status" class="form-control" style="width: auto; padding: 0.3rem 0.6rem; font-size: 0.82rem;" onchange="handleStatusChange(this, <%= r.rent %>)">
                            <option value="Paid" <%= r.status === 'Paid' ? 'selected' : '' %>>Paid</option>
                            <option value="Partial" <%= r.status === 'Partial' ? 'selected' : '' %>>Partial</option>
                            <option value="Pending" <%= r.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                          </select>

                          <button type="submit" class="btn btn-outline btn-sm" style="width: auto;">Save</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              No resident payment records found for <%= selectedMonth %>.
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    function handleStatusChange(selectElem, roomRent) {
      const form = selectElem.form;
      const amountInput = form.querySelector('input[name="amountPaid"]');
      const val = selectElem.value;

      if (val === 'Partial') {
        const currentVal = Number(amountInput.value) || 0;
        const promptVal = prompt(`Enter partial payment amount for this resident (₹1 to ₹${roomRent - 1}):`, currentVal > 0 && currentVal < roomRent ? currentVal : Math.floor(roomRent / 2));
        if (promptVal !== null) {
          const parsed = Number(promptVal);
          if (isNaN(parsed) || parsed <= 0 || parsed >= roomRent) {
            alert(`Invalid partial amount! Please enter a number between ₹1 and ₹${roomRent - 1}.`);
            selectElem.value = 'Pending';
            amountInput.value = '0';
          } else {
            amountInput.value = parsed;
          }
        } else {
          selectElem.value = 'Pending';
          amountInput.value = '0';
        }
      } else if (val === 'Paid') {
        amountInput.value = roomRent;
      } else if (val === 'Pending') {
        amountInput.value = 0;
      }
    }

    function handleStatusSubmit(form, roomRent) {
      const status = form.querySelector('select[name="status"]').value;
      const amountInput = form.querySelector('input[name="amountPaid"]');
      if (status === 'Partial') {
        const parsed = Number(amountInput.value);
        if (isNaN(parsed) || parsed <= 0 || parsed >= roomRent) {
          alert(`Please provide a valid partial amount between ₹1 and ₹${roomRent - 1}.`);
          return false;
        }
      }
      return true;
    }
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
