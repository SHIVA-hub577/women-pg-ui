<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pujyasritha's Living — a safe, warm, boutique women's PG residence in Hyderabad. Furnished rooms with home-cooked food, 24/7 security, and a caring community.">
  <title>Pujyasritha's Living — A Home Away From Home</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..800;1,7..72,400..700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Hero visual grid float animation */
    .hero-visual { position: relative; }
    .hero-visual-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
    .hero-vcard {
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(237,201,213,0.45);
      border-radius: 16px;
      padding: 1.1rem 1.25rem;
      box-shadow: 0 6px 20px rgba(74,21,48,0.08);
      transition: transform 0.3s ease;
    }
    .hero-vcard:nth-child(even) { margin-top: 1.5rem; }
    .hero-vcard-icon { font-size: 1.6rem; margin-bottom: 0.5rem; }
    .hero-vcard-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
    .hero-vcard-value { font-family: 'Literata', serif; font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-top: 0.15rem; }
    .hero-vcard-sub { font-size: 0.75rem; color: var(--text-muted); }

    /* Gradient section bg */
    .section-bg-warm { background: linear-gradient(180deg, var(--surface-canvas) 0%, #fdf5f8 100%); }
    .section-bg-sage  { background: linear-gradient(180deg, #f2faf6 0%, #ebf7f1 100%); }

    /* Room type pill */
    .sharing-pill {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: var(--primary-faint); color: var(--primary);
      border: 1px solid var(--primary-soft); border-radius: 9999px;
      padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 700;
    }

    /* Contact card */
    .contact-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.875rem 0; border-bottom: 1px solid rgba(237,201,213,0.2); }
    .contact-row:last-child { border-bottom: none; }
    .contact-icon { width: 38px; height: 38px; border-radius: 10px; background: rgba(194,116,138,0.15); display: flex; align-items: center; justify-content: center; color: #c2748a; flex-shrink: 0; }
    .contact-label { font-size: 0.75rem; color: rgba(245,220,229,0.55); margin-bottom: 0.1rem; }
    .contact-value { font-size: 0.9rem; font-weight: 600; color: #f5dce5; }
  </style>
</head>
<body>
  <%- include('partials/header', { user: typeof user !== 'undefined' ? user : null }) %>

  <!-- HERO SECTION -->
  <section class="hero-section" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <div class="hero-blob hero-blob-1"></div>
      <div class="hero-blob hero-blob-2"></div>
      <div class="hero-blob hero-blob-3"></div>
    </div>
    <canvas id="hero-canvas" aria-hidden="true"></canvas>

    <div class="hero-content">
      <!-- Left: Copy -->
      <div class="reveal">
        <div class="hero-eyebrow">
          <span class="hero-eyebrow-dot"></span>
          Now Accepting Residents · Hyderabad
        </div>
        <h1 id="hero-heading" class="hero-title">
          Your <em>safe haven</em><br>in the city.
        </h1>
        <p class="hero-subtitle">
          Pujyasritha's Living is a boutique women's PG residence offering furnished rooms, home-cooked meals, 24/7 CCTV security, and a warm community — everything you need to thrive.
        </p>
        <div class="hero-actions">
          <a href="/register" class="btn btn-primary" id="hero-cta-register">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
            Request a Room
          </a>
          <a href="#portals" class="btn btn-outline" id="hero-cta-portals" style="width:auto;">
            Sign In
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="hero-trust-bar">
          <div class="hero-trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            24/7 Security
          </div>
          <div class="hero-trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
            Prime Location
          </div>
          <div class="hero-trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Women Only
          </div>
        </div>
      </div>

      <!-- Right: Visual stat cards -->
      <div class="hero-visual reveal" style="animation-delay:0.15s;">
        <div class="snapshot-card" style="margin-bottom:1.25rem;">
          <div class="snapshot-head">
            <span class="snapshot-title">Residence snapshot</span>
            <span class="snapshot-pill"><span class="snapshot-dot" aria-hidden="true"></span>Rooms available</span>
          </div>
          <div class="snapshot-stats">
            <div class="snapshot-stat">
              <span class="snapshot-icon snapshot-icon-plum" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5"/><path d="M3 18h18"/><path d="M7 11V8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3"/></svg>
              </span>
              <span class="snapshot-value">4</span>
              <span class="snapshot-label">Room types</span>
              <span class="snapshot-sub">1–4 sharing, fully furnished</span>
            </div>
            <div class="snapshot-stat">
              <span class="snapshot-icon snapshot-icon-honey" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12"/><path d="M6 8h12"/><path d="M6 13l6 8 6-8"/></svg>
              </span>
              <span class="snapshot-value">₹5,000</span>
              <span class="snapshot-label">Rooms from</span>
              <span class="snapshot-sub">per month · meals &amp; WiFi included</span>
            </div>
            <div class="snapshot-stat">
              <span class="snapshot-icon snapshot-icon-sage" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13A4 4 0 0 1 19 7a4 4 0 0 1-3 3.87"/></svg>
              </span>
              <span class="snapshot-value">40+</span>
              <span class="snapshot-label">Women residents</span>
              <span class="snapshot-sub">a women-only community</span>
            </div>
          </div>
          <p class="snapshot-foot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span><strong>5★ safety</strong> · CCTV, biometric entry &amp; in-house warden</span>
          </p>
        </div>
        <div class="hero-visual-cards">
          <div class="hero-vcard anim-float">
            <div class="hero-vcard-icon">🔒</div>
            <div class="hero-vcard-label">Security</div>
            <div class="hero-vcard-value">24/7 CCTV</div>
            <div class="hero-vcard-sub">Biometric entry</div>
          </div>
          <div class="hero-vcard anim-float" style="animation-delay:1.5s;">
            <div class="hero-vcard-icon">🍱</div>
            <div class="hero-vcard-label">Meals</div>
            <div class="hero-vcard-value">Home-cooked</div>
            <div class="hero-vcard-sub">3 meals daily</div>
          </div>
          <div class="hero-vcard anim-float" style="animation-delay:0.8s;">
            <div class="hero-vcard-icon">🛏️</div>
            <div class="hero-vcard-label">Rooms</div>
            <div class="hero-vcard-value">Fully Furnished</div>
            <div class="hero-vcard-sub">1–4 sharing</div>
          </div>
          <div class="hero-vcard anim-float" style="animation-delay:2s;">
            <div class="hero-vcard-icon">📶</div>
            <div class="hero-vcard-label">Connectivity</div>
            <div class="hero-vcard-value">High-Speed WiFi</div>
            <div class="hero-vcard-sub">Unlimited data</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AMENITIES MARQUEE -->
  <div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee-track" id="marqueeTrack">
      <span class="marquee-item"><span class="marquee-dot"></span>Home-Cooked Meals</span>
      <span class="marquee-item"><span class="marquee-dot"></span>24/7 CCTV Security</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Biometric Entry</span>
      <span class="marquee-item"><span class="marquee-dot"></span>High-Speed WiFi</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Fully Furnished Rooms</span>
      <span class="marquee-item"><span class="marquee-dot"></span>RO Drinking Water</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Regular Housekeeping</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Laundry Facility</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Power Backup</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Women Only</span>
      <!-- duplicate for seamless loop -->
      <span class="marquee-item"><span class="marquee-dot"></span>Home-Cooked Meals</span>
      <span class="marquee-item"><span class="marquee-dot"></span>24/7 CCTV Security</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Biometric Entry</span>
      <span class="marquee-item"><span class="marquee-dot"></span>High-Speed WiFi</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Fully Furnished Rooms</span>
      <span class="marquee-item"><span class="marquee-dot"></span>RO Drinking Water</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Regular Housekeeping</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Laundry Facility</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Power Backup</span>
      <span class="marquee-item"><span class="marquee-dot"></span>Women Only</span>
    </div>
  </div>

  <!-- PORTALS SECTION -->
  <section id="portals" style="padding:5rem 0;background:var(--surface-canvas);" aria-labelledby="portals-heading">
    <div class="container" style="text-align:center;margin-bottom:2.5rem;">
      <div class="section-eyebrow" style="justify-content:center;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Resident Portals
      </div>
      <h2 id="portals-heading" class="section-title">Sign in to your portal</h2>
      <p class="section-sub" style="margin:0.5rem auto 0;">Access your account, manage payments, and stay connected with the community.</p>
    </div>
    <div class="portal-grid">
      <!-- Admin Portal -->
      <div class="portal-card reveal tilt-card-3d">
        <div class="portal-card-icon" style="background:linear-gradient(135deg,#4a1530,#8b2f58);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
            <circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/>
            <path d="M17 21v-2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/>
          </svg>
        </div>
        <div class="portal-card-title">Admin</div>
        <div class="portal-card-desc">Manage rooms, tenants, payments, complaints, and departures from one central hub.</div>
        <div class="portal-card-links">
          <a href="/admin/login" class="btn btn-primary btn-sm" id="admin-login-btn">Login</a>
          <a href="/admin/register" class="btn btn-outline btn-sm" id="admin-register-btn">Register</a>
        </div>
      </div>

      <!-- Resident Portal -->
      <div class="portal-card reveal tilt-card-3d" style="transition-delay:0.1s;">
        <div class="portal-card-icon" style="background:linear-gradient(135deg,#2d6b4a,#52a679);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
          </svg>
        </div>
        <div class="portal-card-title">Resident</div>
        <div class="portal-card-desc">View your room details, track rent payments, connect with roommates, and raise complaints.</div>
        <div class="portal-card-links">
          <a href="/login" class="btn btn-primary btn-sm" id="tenant-login-btn" style="background:#2d6b4a;border-color:#2d6b4a;">Login</a>
          <a href="/register" class="btn btn-outline btn-sm" id="tenant-register-btn">Register</a>
        </div>
      </div>

      <!-- Worker Portal -->
      <div class="portal-card reveal tilt-card-3d" style="transition-delay:0.2s;">
        <div class="portal-card-icon" style="background:linear-gradient(135deg,#b8762e,#d9a55c);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
            <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 1 1 4.93 19.07"/><path d="m12 2 2 7-7 3 5-3-3-5 3-2z"/>
          </svg>
        </div>
        <div class="portal-card-title">Maintenance</div>
        <div class="portal-card-desc">View assigned complaints, update task progress, and mark issues as resolved.</div>
        <div class="portal-card-links">
          <a href="/worker/login" class="btn btn-primary btn-sm" id="worker-login-btn" style="background:#b8762e;border-color:#b8762e;">Login</a>
          <a href="/worker/register" class="btn btn-outline btn-sm" id="worker-register-btn">Register</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ROOM TYPES SECTION -->
  <section id="rooms" style="padding:5rem 0;" class="section-bg-warm" aria-labelledby="rooms-heading">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1.5rem;margin-bottom:2.5rem;">
        <div style="max-width:34rem;">
          <div class="section-eyebrow">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 22h20"/><path d="M2 11h20"/><path d="M4 22V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18"/></svg>
            Room Types
          </div>
          <h2 id="rooms-heading" class="section-title">Choose your comfort</h2>
          <p class="section-sub">Fully furnished rooms with housekeeping and 24/7 security. Pick the sharing option that fits your budget.</p>
        </div>
        <a href="/register" class="btn btn-outline" id="rooms-cta-btn" style="width:auto;">Request a room</a>
      </div>
    </div>

    <%
      /* Defined once, rendered twice so the tour loops seamlessly.
         The second pass is hidden from assistive tech. */
      const roomTypes = [
        {
          img: '/Room-photos/1sharing-room.webp',
          alt: 'Single-sharing room with a private bathroom, AC and a study desk',
          badge: 'Private',
          badgeColor: '#4a1530',
          name: 'Single Sharing',
          occupancy: '1 person',
          price: '12,000',
          advance: '₹50,000',
          features: ['Private bathroom', 'AC + fan', 'Study desk & wardrobe']
        },
        {
          img: '/Room-photos/2-sharing-room.webp',
          alt: 'Double-sharing room with two study desks, AC and a shared bathroom',
          badge: 'Popular',
          badgeColor: '#2d6b4a',
          name: 'Double Sharing',
          occupancy: '2 people',
          price: '8,500',
          advance: '₹35,000',
          features: ['Shared bathroom', 'AC + fan', '2 study desks']
        },
        {
          img: '/Room-photos/3-sharing-room.webp',
          alt: 'Triple-sharing room with a wardrobe for each resident and a shared bathroom',
          badge: 'Value',
          badgeColor: '#8a5518',
          name: 'Triple Sharing',
          occupancy: '3 people',
          price: '6,500',
          advance: '₹25,000',
          features: ['Shared bathroom', 'Fan + cooler', 'Wardrobe per person']
        },
        {
          img: '/Room-photos/4-sharing-room.webp',
          alt: 'Four-sharing room with bunk or single beds, a fan and a common bathroom',
          badge: 'Budget',
          badgeColor: '#6b2145',
          name: 'Four Sharing',
          occupancy: '4 people',
          price: '5,000',
          advance: '₹20,000',
          features: ['Common bathroom', 'Fan + cooler', 'Bunk or single beds']
        }
      ];
    %>

    <div class="room-tour reveal" id="roomTour">
      <div class="room-carousel" role="group" aria-label="Room types and monthly rent">
        <div class="room-carousel-track">
          <% [false, true].forEach(function (isDuplicate) { %>
            <% roomTypes.forEach(function (room) { %>
              <article class="room-slide"<% if (isDuplicate) { %> aria-hidden="true" inert<% } %>>
                <div class="room-slide-media">
                  <img src="<%= room.img %>" alt="<%= isDuplicate ? '' : room.alt %>" decoding="async">
                  <span class="room-slide-badge" style="background:<%= room.badgeColor %>;"><%= room.badge %></span>
                  <span class="room-slide-price"><strong>₹<%= room.price %></strong> <span>/ month</span></span>
                </div>
                <div class="room-slide-body">
                  <h3 class="room-slide-title"><%= room.name %></h3>
                  <p class="room-slide-meta"><%= room.occupancy %> · +<%= room.advance %> one-time advance</p>
                  <ul class="room-slide-features">
                    <% room.features.forEach(function (feature) { %>
                      <li><%= feature %></li>
                    <% }); %>
                  </ul>
                  <a href="/register" class="room-slide-cta"<% if (isDuplicate) { %> tabindex="-1"<% } %>>Request this room <span aria-hidden="true">&#8594;</span></a>
                </div>
              </article>
            <% }); %>
          <% }); %>
        </div>
      </div>
      <div class="container room-carousel-controls">
        <p class="room-carousel-hint">The room tour scrolls automatically — hover to pause.</p>
        <button type="button" class="room-carousel-toggle" id="roomCarouselToggle" aria-pressed="false" aria-controls="roomTour">
          <svg class="icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
          <svg class="icon-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <span class="room-carousel-toggle-label">Pause tour</span>
        </button>
      </div>
    </div>
  </section>

  <!-- FEATURES / AMENITIES -->
  <section id="amenities" style="padding:5rem 0;background:var(--surface-canvas);" aria-labelledby="amenities-heading">
    <div class="container">
      <div style="text-align:center;margin-bottom:2.5rem;" class="reveal">
        <div class="section-eyebrow" style="justify-content:center;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Amenities
        </div>
        <h2 id="amenities-heading" class="section-title">Everything included</h2>
        <p class="section-sub" style="margin:0.5rem auto 0;">Thoughtfully designed to make you feel right at home.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal">
          <div class="feature-icon" style="background:#fdf5f7;">🍱</div>
          <div class="feature-title">Home-Cooked Meals</div>
          <div class="feature-desc">Fresh breakfast, lunch, and dinner prepared daily with care by our in-house cook.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.05s;">
          <div class="feature-icon" style="background:#fdf5f7;">🔒</div>
          <div class="feature-title">24/7 Security</div>
          <div class="feature-desc">Full CCTV coverage, biometric entry, and security personnel around the clock.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.1s;">
          <div class="feature-icon" style="background:#f2faf6;">📶</div>
          <div class="feature-title">High-Speed WiFi</div>
          <div class="feature-desc">Unlimited high-bandwidth internet for studying, streaming, and working from home.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.15s;">
          <div class="feature-icon" style="background:#fdfaf4;">🧺</div>
          <div class="feature-title">Laundry</div>
          <div class="feature-desc">Washing machines available on every floor with weekly laundry assistance.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.2s;">
          <div class="feature-icon" style="background:#f2faf6;">💧</div>
          <div class="feature-title">RO Drinking Water</div>
          <div class="feature-desc">Purified RO water dispensers on every floor, available 24/7.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.25s;">
          <div class="feature-icon" style="background:#fdf5f7;">⚡</div>
          <div class="feature-title">Power Backup</div>
          <div class="feature-desc">Generator backup ensures zero downtime during outages, day or night.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.3s;">
          <div class="feature-icon" style="background:#fdfaf4;">🧹</div>
          <div class="feature-title">Housekeeping</div>
          <div class="feature-desc">Regular room cleaning and common area maintenance keeps your space fresh.</div>
        </div>
        <div class="feature-card reveal" style="transition-delay:0.35s;">
