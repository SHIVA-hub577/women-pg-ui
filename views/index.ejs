  <!-- SCROLL REVEAL + COUNTER ANIMATION -->
  <script>
    // Scroll reveal
    const reveals = document.querySelectorAll('.reveal');
    const showAll = () => reveals.forEach(el => el.classList.add('visible'));
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      reveals.forEach(el => observer.observe(el));

      // Safety net: if the observer never fires for something already on screen,
      // reveal it anyway so content can never stay permanently invisible.
      window.addEventListener('load', () => setTimeout(() => {
        reveals.forEach(el => {
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('visible');
        });
      }, 1000));
    } else {
      showAll();
    }

    // 3D tilt effect
    const tiltCards = document.querySelectorAll('.tilt-card-3d');
    tiltCards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(1200px) rotateY(${x * 12}deg) rotateX(${-y * 12}deg) scale(1.02)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    });

    // Room tour: manual pause control (pausing also happens on hover/focus via CSS)
    const roomTour = document.getElementById('roomTour');
    const roomTourToggle = document.getElementById('roomCarouselToggle');
    if (roomTour && roomTourToggle) {
      roomTourToggle.addEventListener('click', () => {
        const isPaused = roomTour.classList.toggle('is-paused');
        roomTourToggle.setAttribute('aria-pressed', String(isPaused));
        roomTourToggle.querySelector('.room-carousel-toggle-label').textContent = isPaused ? 'Play tour' : 'Pause tour';
      });
    }

    // Lazy Three.js hero canvas — floating geometry in the brand palette
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof THREE !== 'undefined') {
        const canvas = document.getElementById('hero-canvas');
        if (!canvas) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
        camera.position.z = 6;
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const shapes = [];
        const geos = [new THREE.OctahedronGeometry(0.6, 0), new THREE.TetrahedronGeometry(0.5, 0), new THREE.IcosahedronGeometry(0.55, 0)];
        const mats = [
          new THREE.MeshPhongMaterial({ color: 0x8b2f58, wireframe: true, opacity: 0.45, transparent: true }),
          new THREE.MeshPhongMaterial({ color: 0xb8762e, wireframe: true, opacity: 0.35, transparent: true }),
          new THREE.MeshPhongMaterial({ color: 0x2d6b4a, wireframe: true, opacity: 0.35, transparent: true }),
        ];
        for (let i = 0; i < 9; i++) {
          const m = new THREE.Mesh(geos[i % 3], mats[i % 3]);
          m.position.set((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 6, (Math.random() - 0.5) * 3);
          m.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
          shapes.push(m);
          scene.add(m);
        }
        scene.add(new THREE.AmbientLight(0xfff0f5, 0.8));
        const dirLight = new THREE.DirectionalLight(0xc2748a, 1.2);
        dirLight.position.set(5, 5, 5);
        scene.add(dirLight);

        let stopped = false;
        const io = new IntersectionObserver(entries => { stopped = !entries[0].isIntersecting; });
        io.observe(canvas);
        document.addEventListener('visibilitychange', () => { stopped = document.hidden; });

        let elapsed = 0;
        const clock = new THREE.Clock();
        function animate() {
          requestAnimationFrame(animate);
          if (stopped || reduceMotion) return;
          elapsed += Math.min(clock.getDelta(), 0.05);
          shapes.forEach((s, i) => {
            s.rotation.x += 0.003 + i * 0.001;
            s.rotation.y += 0.004 + i * 0.0005;
            s.position.y += Math.sin(elapsed + i) * 0.002;
          });
          renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
          camera.aspect = canvas.clientWidth / canvas.clientHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
          if (reduceMotion) renderer.render(scene, camera);
        });

        if (reduceMotion) renderer.render(scene, camera);
      }
    });
  </script>
